# PayPal REST app credentials (Sandbox: developer.paypal.com → Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Webhook ID shown after registering the webhook URL on the same PayPal app.
# Required for verifying real PayPal webhooks.
PAYPAL_WEBHOOK_ID=

# Local-only HMAC secret for scripts/simulate-webhook.mjs (32+ chars).
# Ignored when NODE_ENV=production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYTRACE_SIMULATED_WEBHOOK_SECRET=

# Optional
# PAYTRACE_DB_PATH=.data/paytrace-db.json
# PAYTRACE_AUTO_RECONCILE=true

# For a public demo deploy: enable the "Simulate lost update" tool and
# require a shared passcode for approvals, staging and AI runs.
# PAYTRACE_DEMO_MODE=true
# PAYTRACE_APPROVER_PASSCODE=

# Claude API key for the AI incident investigator (or run `ant auth login`).
ANTHROPIC_API_KEY=
# PAYTRACE_AI_MODEL=claude-opus-5-5

# Optional: use OpenAI instead of (or alongside) Claude for the investigator.
# With both keys set, Claude is used unless PAYTRACE_AI_PROVIDER says otherwise.
OPENAI_API_KEY=
# PAYTRACE_OPENAI_MODEL=gpt-4.1
# PAYTRACE_AI_PROVIDER=anthropic   # or openai
